{
  "edge_base_url": "https://caroline-phone-dev.example.workers.dev",
  "required_header": "x-caroline-key: <ElevenLabs secret reference>",
  "tools": [
    {
      "name": "resolve_caroline_contact_phone",
      "method": "POST",
      "path": "/runtime/phone/contact-resolve",
      "required_body": ["conversation_id"],
      "optional_body": ["name", "phone"],
      "policy_bucket": "owner"
    },
    {
      "name": "send_caroline_text_phone",
      "method": "POST",
      "path": "/runtime/phone/sms",
      "required_body": ["conversation_id", "to_number", "message_summary"],
      "optional_body": ["execute_at", "timezone", "target_contact_ref", "linked_call_ref", "original_instruction"],
      "policy_bucket": "owner"
    },
    {
      "name": "query_caroline_shared_schedule",
      "method": "POST",
      "path": "/runtime/phone/calendar-read",
      "required_body": ["conversation_id"],
      "optional_body": ["start_at", "end_at", "subject_phone", "limit"],
      "policy_bucket": "calendar_read"
    },
    {
      "name": "set_current_caller_on_hold",
      "method": "POST",
      "path": "/runtime/phone/hold",
      "required_body": ["conversation_id"],
      "optional_body": ["reason_code", "reason_summary"],
      "policy_bucket": "hold"
    },
    {
      "name": "record_reentry_acknowledgement",
      "method": "POST",
      "path": "/runtime/phone/reentry-ack",
      "required_body": ["conversation_id"],
      "optional_body": [],
      "policy_bucket": "reentry"
    }
  ]
}
