# Names only. Never put production values in this file.
# Caroline provider/application/database credentials live in Infisical Development.
# The only Cloudflare application Worker secrets are the two secrets-gateway access values.
GATEWAY_TOKEN=
GATEWAY_URL=

# Non-secret runtime variables are configured in Cloudflare/wrangler.toml.
# WORKER_NAME=caroline-phone
# ENVIRONMENT=production
# CAROLINE_PHONE_PUBLIC_URL=https://caroline-phone.customerservice-882.workers.dev
# CALL_CONTEXT_TTL_SECONDS=7200

# Optional local Wrangler authentication only; keep real values outside the project folder.
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_ACCOUNT_ID=
