# Required: bearer token expected by Docker MCP Gateway on HTTP/SSE requests.
MCP_GATEWAY_AUTH_TOKEN=<set-a-random-secret>

# Required for enabled MCP servers
GITHUB_PERSONAL_ACCESS_TOKEN=<set-github-token>
CLOUDFLARE_API_TOKEN=<set-cloudflare-token>
ELEVENLABS_API_KEY=<set-elevenlabs-api-key>
SUPABASE_ACCESS_TOKEN=<set-supabase-access-token>
NEON_API_KEY=
