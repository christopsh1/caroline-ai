{
  "mcpServers": {
    "github": {
      "type": "streamable-http",
      "enabled": true,
      "url": "https://api.githubcopilot.com/mcp/",
      "namespace": "github",
      "readOnly": false,
      "prefixTools": true,
      "toolFilter": ["*"],
      "resourceFilter": ["*"],
      "promptFilter": ["*"],
      "timeout": 15
